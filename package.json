{
  "name": "agencymem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @agencymem/gateway --filter @agencymem/runner --filter @agencymem/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:cypher": "tsx scripts/no-inline-cypher.ts",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "sim:run": "tsx --env-file-if-exists=.env apps/simulator/src/main.ts",
    "cost:report": "tsx --env-file-if-exists=.env scripts/cost-report.ts",
    "test:load": "vitest run tests/load",
    "test:restart": "vitest run tests/restart",
    "test:isolation": "vitest run tests/isolation",
    "eval:discovery": "tsx --env-file-if-exists=.env tests/discovery-eval/score.ts",
    "fixtures:build": "tsx scripts/build-fixtures.ts"
  },
  "devDependencies": {
    "@agencymem/contracts": "workspace:*",
    "@agencymem/graph": "workspace:*",
    "@agencymem/ingest": "workspace:*",
    "@agencymem/llm": "workspace:*",
    "@agencymem/memory": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "dependency-cruiser": "18.4.0",
    "docx": "9.8.0",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "pdfkit": "0.20.2",
    "prettier": "3.9.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
