# Copy to .env and fill in. Never commit .env. Empty means "not set".
# Defaults are shown in comments; a variable with no default is required by the apps named.

# FalkorDB. Default redis://localhost:6379. docker-compose.yml publishes host port 6380,
# so a local .env needs redis://localhost:6380 unless you change the compose port.
FALKORDB_URL=
# Gateway port. Default 4000.
AM_PORT=
# Used by the runner, build sessions and the hook. Default http://127.0.0.1:4000.
GATEWAY_URL=

# Route tokens. Gateway: all three. Runner: agent and hook. Simulator: UI.
AM_AGENT_TOKEN=
AM_UI_TOKEN=
AM_HOOK_TOKEN=

# Primary OpenAI-compatible endpoint. Required by runner and simulator.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_THIN=
LLM_MODEL_DEEP=
# Timeout per model call. Default 60000.
LLM_TIMEOUT_MS=

# Fallback endpoint. Required by runner and simulator.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_THIN=
OPENROUTER_MODEL_DEEP=
# Build model on OpenRouter. Required by runner.
OPENROUTER_BUILD_MODEL=

# Build model at the primary endpoint. Required by runner.
BUILD_MODEL=
# OpenCode version the runner checks at start. Default 1.18.32.
OPENCODE_VERSION=
# Number of build workers, 1 or 2. Default 1.
BUILD_WORKERS=

# Set per run by the worker for each opencode run. Leave empty.
AM_PROJECT_ID=
AM_WORKER_ID=

# Lease length and heartbeat interval in ms. Defaults 600000 and 60000.
LEASE_MS=
HEARTBEAT_MS=
# Size limits in characters. Defaults 12000 (get_task_context) and 40000 (recall_context).
CONTEXT_MAX_CHARS=
CONTEXT_RECALL_MAX_CHARS=

# Simulator seed and number of pre-run projects. Defaults 42 and 3.
SIM_SEED=
SIM_PROJECTS=

# Where code and uploads live. WORKSPACES_DIR must be outside the AgencyMem repository.
# Defaults ../agencymem-workspaces and ./data/uploads.
WORKSPACES_DIR=
UPLOADS_DIR=
